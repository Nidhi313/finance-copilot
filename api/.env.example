# Settings for the API. Copy to api/.env (Docker Compose reads it too). Never commit .env.

# --- Sign-in -------------------------------------------------------------------
# dev   = one local demo user, no sign-in (default)
# entra = real sign-in with Microsoft Entra External ID
AUTH_MODE=dev
# Needed when AUTH_MODE=entra. None of these are secrets.
ENTRA_TENANT_SUBDOMAIN=
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
# People allowed to manage country packs (JSON list of emails)
ADMIN_EMAILS=["demo@local"]

# --- Only when running the API outside Docker ---------------------------------
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
ENVIRONMENT=local
# Tests use their own database, created automatically:
TEST_DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance_test
