# Copy to web/.env.local (not committed). Restart `npm run dev` after changing it.
VITE_API_URL=http://localhost:8000

# dev   = no sign-in, the API's local demo user (default)
# entra = sign in with Microsoft Entra External ID
VITE_AUTH_MODE=dev
VITE_ENTRA_TENANT_SUBDOMAIN=
VITE_ENTRA_WEB_CLIENT_ID=
# api://<finance-copilot-api client id>/access_as_user
VITE_ENTRA_API_SCOPE=
